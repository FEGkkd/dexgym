                        append rel physics:body0 = </marvin_m6_dual_arm_wujihand2_beta2/Geometry/pedestal/center_mount>
                        custom rel physics:body1
                        append rel physics:body1 = </marvin_m6_dual_arm_wujihand2_beta2/Geometry/pedestal/center_mount/Base_R>
                        point3f physics:localPos0 = (0.09, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.5, 0.5, 0.5, 0.5)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                def PhysicsFixedJoint "PhysicsFixedJoint"
                {
                    custom rel physics:body0
                    append rel physics:body0 = </marvin_m6_dual_arm_wujihand2_beta2/Geometry/pedestal>
                    custom rel physics:body1
                    append rel physics:body1 = </marvin_m6_dual_arm_wujihand2_beta2/Geometry/pedestal/center_mount>
                    point3f physics:localPos0 = (0, 0, 1.25)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }

            def PhysicsFixedJoint "PhysicsFixedJoint"
            {
                custom rel physics:body0
                append rel physics:body0 = </marvin_m6_dual_arm_wujihand2_beta2>
                custom rel physics:body1
                append rel physics:body1 = </marvin_m6_dual_arm_wujihand2_beta2/Geometry/pedestal>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (6.123234e-17, 0, 0, 1)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.002
            float newton:torsionalFriction = 0.08
            float physics:dynamicFriction = 0.9
            float physics:staticFriction = 0.9
        }

        over "PhysicsMaterial_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1
        }
    }
}

