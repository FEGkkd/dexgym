        def MjcActuator "Joint1_L_position"
        {
            uniform double[] mjc:biasPrm = [0, -400, -45, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 3.1067
            uniform double mjc:ctrlRange:min = -3.1067
            uniform double mjc:forceRange:max = 108
            uniform double mjc:forceRange:min = -108
