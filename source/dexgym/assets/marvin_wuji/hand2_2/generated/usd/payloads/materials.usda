#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "arm_silver"
    {
        color3f inputs:diffuseColor = (0.2632734, 0.2956998, 0.3423916)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.45
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/arm_silver/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/arm_silver.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/arm_silver.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/arm_silver.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/arm_silver.inputs:roughness>
            token outputs:surface
        }
    }

