            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            custom rel material:binding:physics = None
            int mjc:group = 2
            int mjc:priority = 1
            double[] mjc:solref = [0.02, 1.5]
            float newton:contactGap = 0 (
                limits = {
                    dictionary hard = {
                        double minimum = 0
