    def Xform "r_wrist" (
        prepend references = @./geometries.usd@</Geometries/r_wrist>
    )
    {
        over "r_wrist" (
            apiSchemas = ["MaterialBindingAPI", "MjcImageableAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/r_wrist/VisualMaterials/matte_black>
            int mjc:group = 1
        }

        def Scope "VisualMaterials"
        {
            def Material "matte_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/matte_black>
            )
            {
            }
        }
    }

    def Xform "right_palm_collision" (
